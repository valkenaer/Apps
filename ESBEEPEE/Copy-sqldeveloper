Import-Module $env:SMS_ADMIN_UI_PATH.Replace("\bin\i386","\bin\configurationmanager.psd1")
$SiteCode = Get-PSDrive -PSProvider CMSITE
Set-Location "$($SiteCode.Name):\"
$SiteServer = $Env:COMPUTERNAME
       
$Manu            = "Oracle"
$AppName         = "sqldeveloper"
$ExpectedVersion = "26.2.0" 
$ExpectedFileVersion = "26.2.0.186"
$AppDesc         = "Oracle SQL Developer is a free, development environment that simplifies the management of Oracle Database in both traditional and Cloud deployments."
$ExeLocation     = "\\$SiteServer\Sources$\Applications\SBP\$AppName\$ExpectedVersion"
$InstStr         = "powershell.exe -ExecutionPolicy Bypass -File Copy-$AppName.ps1"
$ExpFile         = "$AppName.exe"
$ExpPath         = "c:\$AppName"
$UninstStr   = "powershell.exe Remove-Item c:\$AppName -Recurse -Force"
$DevColl00     = "BSCC0750_BSCC0750"
$Purp        = "Available"
$ConsoleFolderPath = "\Applications\SBP Verzoeken"
$AppFullName = "$Manu $AppName $ExpectedVersion"
$DPGName     = "BSC_DPG"

$clause1 = New-CMDetectionClauseFile -Filename $ExpFile -Path $ExpPath -PropertyType Version -ExpressionOperator IsEquals -ExpectedValue $ExpectedFileVersion -Value

New-CMApplication -Name $AppFullName -Description $AppDesc -Publisher $Manu -SoftwareVersion $ExpectedVersion 
Add-CMScriptDeploymentType -ContentLocation $ExeLocation -ApplicationName $AppFullname -DeploymentTypeName $AppName -InstallCommand $InstStr -UninstallCommand $UninstStr -AddDetectionClause $clause1 -MaximumRuntimeMins 20 -InstallationBehaviorType InstallForSystem -UserInterActionMode Hidden
Start-CMContentDistribution -ApplicationName $AppFullName -DistributionPointGroupName $DPGName
New-CMApplicationDeployment -CollectionName $DevColl00 -Name $AppFullName -DeployAction Install -DeployPurpose $Purp -UserNotification DisplayAll -AvailableDateTime (get-date) -TimeBaseOn LocalTime -Verbose

$MoveApp = Get-CMApplication -Name $AppFullName

If($ConsoleFolderPath) {
    $MoveApp | Move-CMObject -FolderPath "$($SiteCode):\Application$($ConsoleFolderPath)"
}

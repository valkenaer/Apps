# This servicing requires the october MSU of the 24H2 and 25H2; this should be 26100.9711 or 26200.9711

Import-Module $env:SMS_ADMIN_UI_PATH.Replace("\bin\i386","\bin\configurationmanager.psd1")
$SiteCode = Get-PSDrive -PSProvider CMSITE
Set-Location "$($SiteCode.Name):\"
$SiteServer = $Env:COMPUTERNAME
       
$Manu            = "Microsoft"
$AppName         = "Enablement Package"
$ExpectedVersion = "26H2"   
$AppDesc         = "$ExpectedVersion Plugins"
$ExeLocation     = "\\$SiteServer\Sources$\Applications\$Manu\$AppName\$ExpectedVersion"
$InstStr         = "powershell.exe -ExecutionPolicy Bypass -Command `"Add-WindowsPackage -Online -PackagePath Windows11.0-KB5121794-x64_5e20a3cce48d6611b16bdec42b07167f5456586a.msu -NoRestart -ErrorAction Stop`""
$UninstStr   = "powershell.exe Remove-Item arf.zip -Recurse -Force"
$DevColl00     = "BSCC0750_BSCC0750"
$DevColl01     = "Computer All Physical (incl Spark)"
$DevColl02     = "BSC-P All VDI's"
$Purp        = "Required"
$ConsoleFolderPath = "\Applications\Micrsoft"
$AppFullName = "$Manu $AppName Plugins $ExpectedVersion"
$DPGName     = "BSC_DPG"






<#

$KBNumber = "5121794" 
$CBSPath = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\Packages"

# Search for the package identity corresponding to your KB
$Package = Get-ChildItem -Path $CBSPath -ErrorAction SilentlyContinue | 
           Where-Object { $_.Name -like "*KB$KBNumber*" }

if ($Package) {
    # Read the current installation state of the package
    $CurrentState = Get-ItemProperty -Path "HKLM:\$($Package.Name)" -Name "CurrentState" -ErrorAction SilentlyContinue
    
    # CBS State Values: 
    # 70 = Staged (Installed, pending reboot)
    # 112 = Installed (Fully active post-reboot)
    if ($CurrentState.CurrentState -eq 70 -or $CurrentState.CurrentState -eq 112) {
        # Outputting text signals to SCCM that the application is successfully detected
        Write-Host "Installed"
        Exit 0
    }
}

# If not found or not in a staging state, exit cleanly without outputting text
Exit 0

#>

<#

$KBNumber = "5121794" 
$CBSPath = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\Packages"
$Package = Get-ChildItem -Path $CBSPath -ErrorAction SilentlyContinue | 
           Where-Object { $_.Name -like "*KB$KBNumber*" }

if ($Package) {
    $CurrentState = Get-ItemProperty -Path "HKLM:\$($Package.Name)" -Name "CurrentState" -ErrorAction SilentlyContinue
    
    # CBS State Values: 
    # Absent (0 / 0x00): The package is not present or not installed.
    # Uninstall Pending (5 / 0x05): The package is scheduled for removal.
    # Resolving (16 / 0x10): The package dependencies are currently being resolved.
    # Resolved (32 / 0x20): The package dependencies have been resolved.
    # Staging (48 / 0x30): The package files are being unpacked/staged into the system.
    # Staged (64 / 0x40): The package is staged and ready for installation.
    # Superseded (80 / 0x50): The package has been replaced by a newer update.
    # Install Pending (96 / 0x60): The package installation is pending (often requiring a restart).
    # Partially Installed (101 / 0x65): The package installation was interrupted or is incomplete.
    # Installed (112/0x70): The package is fully applied on operating system
    # Permanent (128 / 0x80): The package is a permanent part of the system image and cannot be uninstalled normally.

    if ($CurrentState.CurrentState -eq 70 -or $CurrentState.CurrentState -eq 112 -or $CurrentState.CurrentState -eq 96) {
        Write-Host "Installed"
        Exit 0
    }
}

Exit 0


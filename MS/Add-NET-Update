Import-Module $env:SMS_ADMIN_UI_PATH.Replace("\bin\i386","\bin\configurationmanager.psd1")
$SiteCode = Get-PSDrive -PSProvider CMSITE
Set-Location "$($SiteCode.Name):\"
$SiteServer = $Env:COMPUTERNAME
       
   $Manu            = "Microsoft"
   $AppName         = "Cumulative Update"
   $ExpectedVersion = "KB5127694"   
   $AppDesc         = "This addresses 20 separate security vulnerabilities in the the catagories RCE (including CVE-2026-70007, CVE-2026-70035, CVE-2026-83520, and CVE-2026-96224), DoS (such as CVE-2026-58280 and CVE-2026-96233) and EoP (CVE-2026-69439, CVE-2026-85363), other vulns (CVE-2026-108398"
   $ExeLocation     = "\\$SiteServer\Sources$\Applications\$Manu\$AppName\$ExpectedVersion"
   $InstStr         = "powershell.exe -ExecutionPolicy Bypass -Command `"Add-WindowsPackage -Online -PackagePath `".\windows11.0-kb5127694-x64-ndp481_a1a6f6d3c61e46a77278881fc5f7245bcf09ce3f.msu`" -NoRestart -ErrorAction Stop`""
   $UninstStr   = "powershell.exe Remove-Applications.ps1 -Recurse -Force"
       $DevColl03     = "BSCC0750_BSCC0750"
       $DevColl04     = "Computer All Physical (incl Spark)"
       $DevColl05     = "BSC-P All VDI's"
   $Purp        = "Required"
   $ConsoleFolderPath = "\Applications\Microsoft"
   $AppFullName = "$Manu $AppName $ExpectedVersion"
   $DPGName     = "BSC_DPG"

New-CMApplication -Name $AppFullName -Description $AppDesc -Publisher $Manu -SoftwareVersion $ExpectedVersion 
Add-CMScriptDeploymentType -ContentLocation $ExeLocation -ApplicationName $AppFullname -DeploymentTypeName $AppName -InstallCommand $InstStr -UninstallCommand $UninstStr -ScriptLanguage Powershell -ScriptContent "Invoke-DummyScript -Really" -MaximumRuntimeMins 20 -InstallationBehaviorType InstallForSystem -UserInterActionMode Hidden
Start-CMContentDistribution -ApplicationName $AppFullName -DistributionPointGroupName $DPGName

# New-CMApplicationDeployment -CollectionName $DevColl03 -Name $AppFullName -DeployAction Install -DeployPurpose $Purp -UserNotification HideAll -AvailableDateTime (get-date) -TimeBaseOn LocalTime -Verbose
# New-CMApplicationDeployment -CollectionName $DevColl04 -Name $AppFullName -DeployAction Install -DeployPurpose $Purp -UserNotification HideAll -AvailableDateTime (get-date) -TimeBaseOn LocalTime -Verbose

$MoveApp = Get-CMApplication -Name $AppFullName

If($ConsoleFolderPath) {
    $MoveApp | Move-CMObject -FolderPath "$($SiteCode):\Application$($ConsoleFolderPath)"
    }

<#

if (Get-HotFix -Id "KB5127694" -ErrorAction SilentlyContinue) {
    Write-Output "Installed"
}

